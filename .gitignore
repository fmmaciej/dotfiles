.tmux.conf
.tmux/**
.config/wezterm/tmux-session.sh

# --- Unix-only tools (not used on Windows branch) ---
.config/zsh/**
.zprofile
.zshenv
.zshrc
.rtorrent.rc
.urlview

# --- WezTerm ---
.local/share/wezterm/**

# --- Dotfiles generated VS Code view ---
.vscode-dotfiles/

# --- Windows user profile noise ---
AppData/**
NTUSER.*
ntuser.*
*.lnk
Thumbs.db
desktop.ini

# --- macOS Library (dużo danych, nie dotykać) ---
Library/**
!Library/Application Support/Code/User/settings.json
