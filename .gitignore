# This is a normal checkout, not a work tree covering all of $HOME.
# New source files must be visible to Git; never restore the old blanket '*'.

# Local settings and credentials stay outside the managed package contents.
**/proxy.local.psd1
**/env.local
**/.env
**/.env.*
!**/.env.example
**/.ssh/id_*
**/.ssh/known_hosts
**/.ssh/authorized_keys
**/.ssh/config.local
**/.gnupg/

# Histories and application runtime state, including paths inside packages.
.zsh_history
.bash_history
.python_history
.sqlite_history
.lesshst
.node_repl_history
.irb_history
**/.viminfo
**/_viminfo
**/.cache/
**/.local/state/nvim/
**/.local/share/nvim/
**/.local/share/wezterm/

# Editor dependencies and caches; keep the tracked vim-plug bootstrap.
**/.vim/plugged/
**/.vim/pack/
**/.vim/swap/
**/.vim/undo/
**/.vim/backup/
**/.vim/.netrwhist
**/vimfiles/plugged/
**/vimfiles/pack/
**/vimfiles/swap/
**/vimfiles/undo/
**/vimfiles/backup/
**/.psmux/plugins/
**/.psmux/logs/
**/node_modules/
**/.config/nvim/plugged/
**/.config/nvim/pack/
**/.vscode/extensions/
**/.vscode-server/
**/.vscode-test/
**/__pycache__/
*.py[cod]
*~
*.swp
*.swo

# OS metadata and the retired generated editor view.
.DS_Store
.AppleDouble
.LSOverride
.Trashes
.Spotlight-V100
.fseventsd
NTUSER.*
ntuser.*
Thumbs.db
desktop.ini
.vscode-dotfiles/
