# macOS metadata
.DS_Store
.AppleDouble
.LSOverride
.Trashes
.Spotlight-V100
.fseventsd

# Local settings and secrets are never part of a Stow package.
**/env.local
**/.env
**/.env.*
!**/.env.example

# Shell histories
.zsh_history
.bash_history
.python_history
.sqlite_history
.lesshst
.node_repl_history
.irb_history

# SSH / GPG private state
**/.ssh/id_*
**/.ssh/known_hosts
**/.ssh/authorized_keys
**/.ssh/config.local
**/.gnupg/

# Editor caches and temporary files
*~
*.swp
*.swo
**/.vscode/extensions/
**/.vscode-server/
**/.vscode-test/

# Vim dependencies and runtime state; keep the tracked vim-plug bootstrap.
**/.vim/plugged/
**/.vim/pack/
**/.vim/swap/
**/.vim/undo/
**/.vim/backup/
**/.vim/.netrwhist

# Other application runtime state
**/.tmux/resurrect/
**/.cache/
