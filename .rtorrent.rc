##### CORE #####
directory = ~/downloads/torrents
session = ~/.rtorrent/session
session.use_lock = no

##### WATCH DIR #####
schedule2 = watch,5,5,load.start=~/.rtorrent/watch/*.torrent

##### NETWORK #####
port_range = 50000-50010
port_random = no
check_hash = yes

##### RPC (LOCAL SOCKET) #####
network.scgi.open_local = ~/.rtorrent/rpc.socket

##### UI – VIM STYLE #####
bind = j, down
bind = k, up
bind = h, left
bind = l, right
bind = g, first
bind = G, last

bind = s, start
bind = S, stop
bind = d, close
bind = D, erase

##### SAFETY #####
pieces.hash.on_completion = yes

