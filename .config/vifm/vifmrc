" --- Start: single-tree ---
" only

" --- Skróty trybów ---
" Najpierw wyczyść layout, potem pionowy split i włącz quick view
" (to daje wizualnie jedno drzewo po lewej i podgląd po prawej)
nnoremap ,1 :only<cr>:normal <C-w>v<cr>:view<cr>

" --- Dwa drzewa, bez quick view ---
" Wyczyść layout, pionowy split, wyrównaj szerokości, wyłącz quick view (jeśli było)
nnoremap ,2 :only<cr>:normal <C-w>v<cr>:normal <C-w>=<cr>:view!<cr>

" --- Twardo: pojedyncze okno, bez podglądu ---
nnoremap ,0 :view!<cr>:only<cr>

" --- Wyrównanie szerokości (gdy masz dwa panele) ---
nnoremap ,= :normal <C-w>=<cr>

" --- Ręczny toggle quick view (włącza/wyłącza podgląd w drugim panelu) ---
nnoremap ,p :view<cr>

" --- Motyw ---
if filereadable(expand('~/.config/vifm/colors/wezterm-theme.vifm'))
  source ~/.config/vifm/colors/wezterm-theme.vifm
else
  highlight Win         ctermfg=252 ctermbg=234
  highlight TopLine     ctermfg=244 ctermbg=234
  highlight StatusLine  ctermfg=252 ctermbg=234 cterm=bold
  highlight Border      ctermfg=237
  highlight Directory   ctermfg=32  ctermbg=234 cterm=bold
  highlight Selected    ctermfg=234 ctermbg=32  cterm=bold
  highlight Link        ctermfg=39
  highlight Executable  ctermfg=110
  highlight BrokenLink  ctermfg=196
endif

" --- Fileviewer: tekst, PDF, archiwa ---
if executable('bat')
  fileviewer <text/*> bat --color=always --style=numbers --paging=never %c
  fileviewer {*.md,*.rst,*.toml,*.yaml,*.yml,*.json,*.py,*.rs,*.c,*.cpp,*.h,*.hpp,*.sh,*.zsh,*.bash,*.ts,*.tsx,*.js,*.jsx,*.css,*.scss,*.html,*.htm,.gitignore,.gitattributes,.editorconfig} bat --color=always --style=numbers --paging=never %c
endif

if executable('pdftotext')
  fileviewer {*.pdf},<application/pdf> pdftotext -nopgbrk %c - | sed -n '1,40p'
endif
filetype {*.pdf},<application/pdf> open -a Preview.app

fileviewer {*.zip,*.jar,*.war,*.ear} tar -tf %f
filetype   {*.zip,*.jar,*.war,*.ear} mkdir %f:r && tar -vxf %f --directory %f:r
fileviewer {*.tar,*.tar.gz,*.tgz,*.tar.xz,*.txz,*.tar.bz2,*.tbz2} tar -tf %f
filetype   {*.tar,*.tar.gz,*.tgz,*.tar.xz,*.txz,*.tar.bz2,*.tbz2} tar -vxf %f

if executable('unrar')
  fileviewer *.rar unrar lb %c
  filetype   *.rar unrar x -y -c- -ad %f %s
endif

" --- Podgląd obrazów i wideo INLINE (jedna linia!) ---
if executable('wezterm')
  fileviewer {*.png,*.jpg,*.jpeg,*.gif,*.webp,*.bmp} ~/.config/vifm/scripts/wezterm-preview.sh --image %c
  fileviewer {*.mp4,*.mkv,*.mov,*.avi,*.webm,*.ts}  ~/.config/vifm/scripts/wezterm-preview.sh --video %c
elseif executable('chafa') || executable('viu')
  fileviewer {*.png,*.jpg,*.jpeg,*.gif,*.webp,*.bmp} sh -c 'command -v chafa >/dev/null && chafa %c || viu -n %c'
  if executable('ffprobe')
    fileviewer {*.mp4,*.mkv,*.mov,*.avi,*.webm,*.ts} ffprobe -hide_banner -pretty %c 2>&1 | sed -n "1,25p"
  endif
else
  if executable('identify')
    fileviewer {*.png,*.jpg,*.jpeg,*.gif,*.webp,*.bmp} identify %f
  endif
  if executable('ffprobe')
    fileviewer {*.mp4,*.mkv,*.mov,*.avi,*.webm,*.ts} ffprobe -hide_banner -pretty %c 2>&1 | sed -n "1,25p"
  endif
endif

" --- Skojarzenia „otwórz” (macOS) ---
filetype {*.mp3,*.m4a,*.flac,*.wav} open -a Music.app
filetype {*.mp4,*.mkv,*.mov,*.avi,*.webm} {VLC}  open -a VLC.app,
filetype {*.png,*.jpg,*.jpeg,*.gif,*.webp,*.bmp} open -a Preview.app
