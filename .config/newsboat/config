### NEWSBOAT CONFIG FILE

article-sort-order  desc
auto-reload         yes
browser             firefox %u
confirm-exit        yes
cleanup-on-quit	    no
notify-always	    yes 
notify-program      ~/.config/env/notify-send_newsboat.sh
max-items           100
reload-threads      3
reload-time         15
download-retries    4
download-timeout    10
download-full-page  yes 
save-path           ~/.newsboat/saved_articles
show-read-articles  yes
show-read-feeds     yes
mark-as-read-on-hover no 
# prepopulate-query-feeds yes
always-display-description true 
# bookmark-cmd /home/cirrus/scripts/newsbeuter_bookmarks_surfraw.sh

#
#-------- macros {{{
#------------------------------------------------------
# Note: macro prefix key ( default: , )
external-url-viewer "urlview"
macro v set browser "mpv %u"; open-in-browser; set browser "w3m %u"
macro f set browser "firefox"; open-in-browser; set browser "w3m %u"
macro r set browser "tuir"; open-in-browser; set browser "w3m %u"
# macro t set browser "peerflix"; open-in-browser ; set browser peerflix
macro w set browser "w3m"; open-in-browser; set browser "w3m %u"
# macro p set browser "dmenuhandler"; open-in-browser ; set browser piper

# c copies the link to the clipboard.
# The line below is probably the skiddiest line I've ever written.
macro c set browser "copy(){ echo $1 | wl-copy ;}; copy "; set browser "w3m %u"
#
# formatting and colorization ------------------------------------------

feedlist-format "%-65t %?d?- %-65d&? %> %u"
articlelist-format "%-4i %f %t"
feedlist-title-format "%N %V %> %u feeds with new articles"
articlelist-title-format "%T"
notify-format  "%f unread feeds, %n unread articles"
datetime-format "%Y.%m.%d"
html-renderer "w3m -dump -T text/HTML -cols 100"
 
highlight feedlist "^ *[0-9]+ *N " color4 color0
highlight articlelist "^ *[0-9]+ *N " color4 color0

highlight article "^(Feed|Title|Author|Link|Date|Linux):.*" color6 color0
highlight article "\\[[0-9][0-9]*\\]" color7 color0 bold
highlight article "\\[image [0-9][0-9]*\\]" color7 color0 bold
highlight article "\\[embedded flash: [0-9][0-9]*\\]" color2 color0 bold
highlight article ":.*\\(link\\)$" color4 color0
highlight article ":.*\\(image\\)$" color4 color0
highlight article ":.*\\(embedded flash\\)$" color4 color0
highlight article "^-.*$" color4 color0
highlight article "^\d{1,2}\..*$" color4 color0
highlight article "^\d{2}:\d{2}" color4 color0
# highlight article "^Podcast Download URL:.*" color1 color0
# highlight article "^Link.:" white color10 underline

highlight all "Linux" color6 color0 bold
highlight all "Cpp" color6 color0 bold
highlight all "Github" color6 color0 bold
highlight all "Youtube" color6 color0 bold
highlight all "News" color6 color0 bold
highlight all "Video" color6 color0 bold
highlight all "Alert" red color0 bold

color article		color5 color0 
color background	color8 color0
color listnormal	color9 color0
color listnormal_unread color3 color0
color listfocus		color8 color0 blink
color listfocus_unread	color4 color0 bold
color info		color0 color4 bold

# unbind keys
unbind-key j
unbind-key k
unbind-key J
unbind-key K
unbind-key l
unbind-key h
unbind-key g
unbind-key G

bind-key j down feedlist
bind-key k up feedlist
bind-key j next articlelist
bind-key k prev articlelist
bind-key J next-feed articlelist
bind-key K prev-feed articlelist
bind-key j down article
bind-key k up article
bind-key l open
bind-key h quit
bind-key g home
bind-key G end
bind-key ^F pagedown
bind-key ^B pageup
