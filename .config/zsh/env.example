# Template for private local shell settings.
# Copy to ~/.config/zsh/env.local and put secrets, tokens, and machine-specific paths there.
# env.local is sourced explicitly by ~/.zshrc before numbered modules.

export NOTES_DIR="$HOME/path/to/notes"
export PYTHON_TEMPLATE_DIR="$HOME/path/to/python-template"
export OPENROUTER_API_KEY="sk-or-v1-..."
export ANTHROPIC_BASE_URL="https://openrouter.ai/api"
export ANTHROPIC_AUTH_TOKEN="$OPENROUTER_API_KEY"
export ANTHROPIC_API_KEY=""
