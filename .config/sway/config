### SwayWM Configuration file
#
set $mod Mod4
set $altl Mod1
set $altr Mod5

# xwayland disable

### Widow Colours
#
include "$HOME/.cache/wal/colors-sway"

#                       border	    background	text	    indicator
client.background		    $background
client.focused          $color2	    $color2     $color7	    $color4
client.focused_inactive $color5	    $color5	$color8	    $color4
client.unfocused        $color13    $color13	$color8	    $color4
client.urgent           $color1	    $color1     $color7	    $color4

### Window decoration settings
#
# You can also use any non-zero value if you'd like to have a border
# for_window [class="^.*"] border pixel 0
smart_borders on

gaps inner 45
gaps outer 0

default_border pixel 0
default_floating_border pixel 0

# This font is widely installed, provides lots of unicode glyphs, right-to-left
# text rendering and scalability on retina/hidpi displays (thanks to pango).
# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango: SF Pro Display 11

titlebar_border_thickness 0
# titlebar_padding <h>

hide_edge_borders both
popup_during_fullscreen smart

focus_on_window_activation smart

bindsym $mod+equal gaps inner all plus 5
bindsym $mod+minus gaps inner all minus 5

